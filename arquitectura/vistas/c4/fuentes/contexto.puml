@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml
title Diagrama de Contexto (Nivel 1) - Ferre & Inversiones MIGAL

Person(cliente, "Cliente / Dueño de obra", "Consulta, recibe cotizaciones y decide la compra; suele ser quien paga")
Person(maestro, "Maestro de obra", "Refiere clientes, envía listas de materiales y coordina en obra")
Person(prop, "Propietarios", "Atienden, cotizan, deciden descuentos, promesas y condición de comprobante")
Person(trab, "Trabajadores", "Atienden mostrador, registran interacciones y preparan mercadería")

System_Ext(whatsapp, "WhatsApp / Teléfono", "Canales de consulta, envío de listas y cotizaciones")
System(odoo, "Odoo 18 Community", "CRM (crm + contacts): relación comercial, lead, oportunidad y cotización\nERP (sale_management, point_of_sale, stock, account): pedido confirmado, inventario y facturación interna")
System_Ext(keyfacil, "KeyFacil", "Emisión del comprobante electrónico (SUNAT); operado por los propietarios")

Rel(cliente, whatsapp, "Consulta precios y disponibilidad", "Mensaje / llamada")
Rel(maestro, whatsapp, "Envía lista de materiales / refiere clientes", "Mensaje")
Rel(cliente, prop, "Visita la tienda", "Presencial")
Rel(prop, whatsapp, "Responde y envía cotización (PDF)", "App móvil")
Rel(prop, odoo, "Registra oportunidad, cotiza y aprueba excepciones", "Navegador")
Rel(trab, odoo, "Registra leads e interacciones; consulta stock", "Navegador")
Rel(prop, keyfacil, "Emite boleta o factura y registra la referencia en Odoo", "App web")
@enduml
